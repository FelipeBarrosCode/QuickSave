{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main-window commands only. Filesystem operations additionally require exact-scope, one-use native approval; no remote origins, network or shell plugin.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-capabilities",
    "allow-get-directories",
    "allow-discover-applications",
    "allow-authorize-operation",
    "allow-initialize-repository",
    "allow-backup-folder",
    "allow-list-snapshots",
    "allow-restore-snapshot",
    "allow-operation-status",
    "allow-operation-history"
  ]
}
